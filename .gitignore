/node_modules
/public/hot
/public/storage
/storage/*.key
/vendor
.env
.env.backup
# Repositorio publico: ningun .env con valores reales entra al historico. El propio .env del repo
# lo advierte. Se excluyen todas las variantes (.env.testing, .env.local, .env.production...) y se
# deja pasar solo el ejemplo, que es el unico sin credenciales.
.env.*
!.env.example
.phpunit.result.cache
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log

# Carpeta local del loop de Claude Code (hooks compartidos + scratch de prompts en curso).
# No se versiona: current-prompt.md cambia en cada corrida y no aporta nada al historico del repo.
.claude/
